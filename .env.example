AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=          # Haiku inference profile ID enabled in your account
BEDROCK_FALLBACK_MODEL_ID= # Amazon Nova model ID
ENABLE_PROMPT_CACHE=true
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=350
POLLY_VOICE_ID=Arjun
POLLY_ENGINE=generative  # or neural
POLLY_REGION=us-east-1  # generative voices are not in ap-south-1
TTS_CONCURRENCY=3
TTS_RATE_PCT=94
TTS_COMMA_PAUSE_MS=120
TTS_SENTENCE_PAUSE_MS=420
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_PROMPT="Yash Rajput, Minfy, VIT Vellore, LangGraph, Bedrock, RAG, LoRA, QLoRA, vLLM, OpenSearch, 100x"
RATE_LIMIT_ASK=20/minute;300/day
RATE_LIMIT_STT=20/minute
LOG_LEVEL=INFO
